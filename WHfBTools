# Install module Windows Hello for Business
Install-Module -Name WHfBTools

# Scan for orphaned keys
Get-AzureADWHfBKeys -tenant "yourtenant.onmicrosoft.com" -UserPrincipalName user@domain.com -Logging

# Remove orphaned keys
Remove-AzureADWHfBKey -tenant "yourtenant.onmicrosoft.com" -UserPrincipalName user@domain.com -Logging
