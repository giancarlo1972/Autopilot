<#
.SYNOPSIS
    Collects the Windows Autopilot hardware hash, with preflight network checks,
    a no-internet fallback, and optional upload to SharePoint or ServiceNow.

.DESCRIPTION
    Runs a short preflight (time sync, IPv6 state, connectivity), then collects
    the hardware hash. Uses the official Get-WindowsAutopilotInfo script when the
    PowerShell Gallery is reachable, otherwise reads the hash directly from WMI
    with no downloads.

    Preflight matters at OOBE: clock skew beyond a few minutes breaks Entra join
    and Intune enrolment, and a half-working IPv6 path causes connections to stall
    before falling back to IPv4.

    Diagnostics always run and only report. Changes are made only when you pass a
    fix switch (or -Prep for the recommended set).

    IPv6 handling, two options:
      -PreferIPv4  : sets Tcpip6 DisabledComponents = 0x20. This does NOT disable
                     IPv6; it makes the prefix policy table prefer IPv4 over IPv6.
                     IPv6 stays bound and functional, just deprioritised. This is
                     Microsoft's recommended way to fix the OOBE/enrolment stall,
                     and unlike 0xFF (full disable) it does not risk breaking
                     components. Requires a REBOOT to take effect.
      -DisableIPv6 : hard per-adapter unbind (ms_tcpip6). Immediate, no reboot,
                     but heavier-handed. Use only if -PreferIPv4 is insufficient.

    -Prep enables -FixTime and -PreferIPv4 (the gentle, reboot-required path).

.PARAMETER Prep
    Equivalent to -FixTime -PreferIPv4.

.PARAMETER FixTime
    Configure an external NTP source and force a resync.

.PARAMETER PreferIPv4
    Set DisabledComponents = 0x20 (prefer IPv4 over IPv6). Requires reboot.

.PARAMETER DisableIPv6
    Unbind IPv6 from all physical adapters (immediate, no reboot).

.PARAMETER Online
    Register the device directly in Intune. Prompts for admin credentials.

.PARAMETER GroupTag
    Optional Autopilot group tag (online mode only).

.PARAMETER OutputPath
    Full path for the CSV. Defaults to the script's own folder, then C:\Temp.

.PARAMETER Upload
    After a successful CSV, upload it to the target in -UploadTarget.

.PARAMETER UploadTarget
    SharePoint or ServiceNow. See the upload functions for the env vars / secrets
    each one expects. Secrets are NEVER hardcoded here.

.EXAMPLE
    .\Get-AutopilotHash-Hardened-v3.ps1
    .\Get-AutopilotHash-Hardened-v3.ps1 -Prep
    .\Get-AutopilotHash-Hardened-v3.ps1 -Prep -Upload -UploadTarget ServiceNow
    .\Get-AutopilotHash-Hardened-v3.ps1 -Online -GroupTag "Corp" -Prep
#>

[CmdletBinding()]
param(
    [switch]$Online,
    [string]$GroupTag,
    [string]$OutputPath,
    [switch]$Prep,
    [switch]$FixTime,
    [switch]$PreferIPv4,
    [switch]$DisableIPv6,
    [switch]$Upload,
    [ValidateSet('SharePoint','ServiceNow')]
    [string]$UploadTarget
)

$ErrorActionPreference = 'Stop'
if ($Prep) { $FixTime = $true; $PreferIPv4 = $true }

function Say  { param([string]$m,[string]$c='White') Write-Host $m -ForegroundColor $c }
function Head { param([string]$m) Write-Host ""; Say "--- $m " Cyan }

Write-Host ""
Say "Windows Autopilot Hardware Hash Collection (v3)" Cyan

# --- 1. Elevation check -----------------------------------------------------
$id = [Security.Principal.WindowsIdentity]::GetCurrent()
$isAdmin = ([Security.Principal.WindowsPrincipal]$id).IsInRole(
              [Security.Principal.WindowsBuiltInRole]::Administrator)
if (-not $isAdmin) {
    Say "ERROR: This script must run elevated (or as SYSTEM at OOBE)." Red
    Say "Right-click PowerShell > Run as administrator, then re-run." Yellow
    exit 1
}
Say "Running elevated as: $($id.Name)" Green

# --- 2. Preflight: network -------------------------------------------------
Head "Preflight"
$rebootNeeded = $false

# IPv6 state + handling
$v6 = Get-NetAdapterBinding -ComponentID ms_tcpip6 -ErrorAction SilentlyContinue |
      Where-Object { $_.Enabled }

if ($PreferIPv4) {
    # DisabledComponents = 0x20 : prefer IPv4 over IPv6 (prefix policy table).
    # IPv6 remains bound/functional; this only changes preference order.
    try {
        $tcp6 = 'HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip6\Parameters'
        if (-not (Test-Path $tcp6)) { New-Item -Path $tcp6 -Force | Out-Null }
        $cur = (Get-ItemProperty -Path $tcp6 -Name DisabledComponents -ErrorAction SilentlyContinue).DisabledComponents
        if ($cur -eq 0x20) {
            Say "IPv6 already set to prefer IPv4 (DisabledComponents=0x20)." Green
        } else {
            New-ItemProperty -Path $tcp6 -Name DisabledComponents -PropertyType DWord -Value 0x20 -Force | Out-Null
            Say "IPv6 set to prefer IPv4 (DisabledComponents=0x20)." Green
            Say "  * Takes effect after REBOOT. IPv6 stays enabled, just deprioritised." Yellow
            $rebootNeeded = $true
        }
    } catch {
        Say "Could not set DisabledComponents: $($_.Exception.Message)" Red
    }
}
elseif ($DisableIPv6) {
    if ($v6) {
        foreach ($a in $v6) {
            try {
                Disable-NetAdapterBinding -Name $a.Name -ComponentID ms_tcpip6 -ErrorAction Stop
                Say "IPv6 unbound on $($a.Name)" Green
            } catch {
                Say "Could not unbind IPv6 on $($a.Name): $($_.Exception.Message)" Red
            }
        }
    } else {
        Say "IPv6 not bound on any adapter." Green
    }
}
else {
    if ($v6) {
        Say ("IPv6 enabled on: " + ($v6.Name -join ', ')) Yellow
        Say "  (run with -PreferIPv4 [recommended] or -DisableIPv6)" Yellow
    } else {
        Say "IPv6 not bound on any adapter." Green
    }
}

# Time
$timeOk = $false
try {
    $status = w32tm /query /status 2>&1
    $src    = (w32tm /query /source 2>&1)
    Say "Time source: $src"
    Say "Local time : $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss zzz')"
    if ($status -match 'Last Successful Sync Time:\s*(.+)') {
        Say "Last sync  : $($Matches[1].Trim())"
    }
    if ($src -notmatch 'Local CMOS Clock|Free-running') { $timeOk = $true }
} catch {
    Say "Time service not responding: $($_.Exception.Message)" Yellow
}

if (-not $timeOk) {
    Say "Time is not synchronised to an external source." Yellow
    Say "  Clock skew beyond ~5 minutes breaks Entra join and enrolment." Yellow
    if ($FixTime) {
        try {
            Set-Service w32time -StartupType Automatic -ErrorAction SilentlyContinue
            Start-Service w32time -ErrorAction SilentlyContinue
            w32tm /config /manualpeerlist:"time.windows.com,0x9" /syncfromflags:manual /update | Out-Null
            Restart-Service w32time -ErrorAction SilentlyContinue
            Start-Sleep -Seconds 3
            w32tm /resync /force | Out-Null
            Start-Sleep -Seconds 3
            Say "  Resynced. Source is now: $(w32tm /query /source)" Green
            Say "  Local time: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" Green
        } catch {
            Say "  Time sync failed: $($_.Exception.Message)" Red
            Say "  Check that outbound UDP 123 is permitted." Yellow
        }
    } else {
        Say "  (run with -FixTime to configure NTP and resync)" Yellow
    }
}

# Connectivity to the endpoints enrolment needs
foreach ($h in 'login.microsoftonline.com','ztd.dds.microsoft.com','enterpriseregistration.windows.net') {
    $r = Test-NetConnection -ComputerName $h -Port 443 -WarningAction SilentlyContinue
    if ($r.TcpTestSucceeded) { Say "Reachable: $h" Green }
    else                     { Say "UNREACHABLE: $h" Red }
}

# --- 3. Decide output location ---------------------------------------------
Head "Output"
if (-not $OutputPath) {
    $dir = if ($PSScriptRoot) { $PSScriptRoot } else { 'C:\Temp' }
    if (-not (Test-Path $dir)) { New-Item -Path $dir -ItemType Directory -Force | Out-Null }
    $serialForName = (Get-CimInstance Win32_BIOS).SerialNumber.Trim() -replace '[\\/:*?"<>|]',''
    $OutputPath = Join-Path $dir "AutopilotHash_$serialForName.csv"
}
Say "Output file: $OutputPath" Cyan

# --- 4. Try the official script (needs internet + PSGallery) ----------------
Head "Hash collection"
$useOfficial = $false
try {
    [Net.ServicePointManager]::SecurityProtocol =
        [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
    if (-not (Get-InstalledScript -Name Get-WindowsAutopilotInfo -ErrorAction SilentlyContinue)) {
        Install-PackageProvider -Name NuGet -MinimumVersion 2.8.5.201 -Force | Out-Null
        Set-PSRepository -Name PSGallery -InstallationPolicy Trusted
        Install-Script -Name Get-WindowsAutopilotInfo -Force -Scope AllUsers
        Say "Get-WindowsAutopilotInfo installed." Green
    } else {
        Say "Get-WindowsAutopilotInfo already present." Green
    }
    $useOfficial = $true
}
catch {
    Say "Gallery unavailable. Using direct WMI collection instead." Yellow
    $useOfficial = $false
}

# --- 5a. Online registration (official script only) -------------------------
if ($Online) {
    if (-not $useOfficial) {
        Say "ERROR: -Online requires the official script and internet access." Red
        Say "Re-run without -Online to produce a CSV for manual import." Yellow
        exit 1
    }
    try {
        Say "Registering device in Intune. You will be prompted to sign in..." Yellow
        if ($GroupTag) { Get-WindowsAutopilotInfo -Online -GroupTag $GroupTag }
        else           { Get-WindowsAutopilotInfo -Online }
        Say "Device registered in Intune." Green
        Say "Confirm Profile status = Assigned before booting into setup." Yellow
        if ($rebootNeeded) { Say "NOTE: reboot pending for the IPv4-preference change." Yellow }
        exit 0
    }
    catch {
        Say "Online registration failed: $($_.Exception.Message)" Red
        Say "Producing a CSV instead..." Yellow
    }
}

# --- 5b. Produce the CSV ----------------------------------------------------
try {
    if ($useOfficial) {
        Get-WindowsAutopilotInfo -OutputFile $OutputPath
    }
    else {
        $serial = (Get-CimInstance Win32_BIOS).SerialNumber.Trim()
        $hash   = (Get-CimInstance -Namespace root/cimv2/mdm/dmmap `
                    -ClassName MDM_DevDetail_Ext01 `
                    -Filter "InstanceID='Ext' AND ParentID='./DevDetail'").DeviceHardwareData
        if (-not $hash) { throw "Hardware hash is empty - check TPM state and OS build." }
        'Device Serial Number,Windows Product ID,Hardware Hash' |
            Out-File -FilePath $OutputPath -Encoding ascii -Force
        "$serial,,$hash" | Out-File -FilePath $OutputPath -Encoding ascii -Append
    }
}
catch {
    Say "FAILED: $($_.Exception.Message)" Red
    exit 1
}

# --- 6. Verify the result ---------------------------------------------------
if (-not (Test-Path $OutputPath)) { Say "FAILED: no output file produced." Red; exit 1 }
$lines = Get-Content $OutputPath
if ($lines.Count -lt 2 -or [string]::IsNullOrWhiteSpace($lines[1])) {
    Say "FAILED: output file has no device row." Red; exit 1
}
$fields = $lines[1].Split(',')
if ($fields.Count -lt 3 -or [string]::IsNullOrWhiteSpace($fields[2])) {
    Say "FAILED: hardware hash field is empty." Red; exit 1
}
$deviceSerial = $fields[0]
$deviceHash   = $fields[2]

Head "Result"
Say "SUCCESS" Green
Say "  Serial : $deviceSerial" Cyan
Say "  Hash   : $($deviceHash.Substring(0,[Math]::Min(40,$deviceHash.Length)))..." Cyan
Say "  File   : $OutputPath" Cyan

# --- 7. Optional upload -----------------------------------------------------
# Secrets are read from environment variables / credential store, never hardcoded.
# Recommended: certificate-based Graph app auth for SharePoint, and a vaulted
# service account for ServiceNow. Env vars below are a floor, not a best practice.

function Send-ToSharePoint {
    param([string]$FilePath)
    # Requires an Entra app registration with Sites.Selected (or Sites.ReadWrite.All),
    # granted admin consent. Prefer a certificate over a client secret in production.
    $TenantId = $env:AP_SP_TENANTID
    $ClientId = $env:AP_SP_CLIENTID
    $Secret   = $env:AP_SP_SECRET          # <-- vault this; env var is the minimum
    $SiteHost = $env:AP_SP_HOST            # e.g. contoso.sharepoint.com
    $SitePath = $env:AP_SP_SITEPATH        # e.g. /sites/ITAssets
    $LibPath  = $env:AP_SP_LIBPATH         # e.g. AutopilotHashes (folder in the default drive)

    foreach ($v in 'TenantId','ClientId','Secret','SiteHost','SitePath','LibPath') {
        if (-not (Get-Variable $v -ValueOnly)) { throw "SharePoint upload: missing $v (set AP_SP_* env vars)." }
    }

    $tok = Invoke-RestMethod -Method Post `
        -Uri "https://login.microsoftonline.com/$TenantId/oauth2/v2.0/token" `
        -Body @{ client_id=$ClientId; scope='https://graph.microsoft.com/.default';
                 client_secret=$Secret; grant_type='client_credentials' }
    $hdr = @{ Authorization = "Bearer $($tok.access_token)" }

    $site = Invoke-RestMethod -Headers $hdr `
        -Uri ("https://graph.microsoft.com/v1.0/sites/{0}:{1}" -f $SiteHost,$SitePath)

    $name = Split-Path $FilePath -Leaf
    $uri  = "https://graph.microsoft.com/v1.0/sites/$($site.id)/drive/root:/$LibPath/$name:/content"
    Invoke-RestMethod -Method Put -Headers $hdr -Uri $uri -InFile $FilePath -ContentType 'text/csv' | Out-Null
    Say "  Uploaded to SharePoint: $SitePath/$LibPath/$name" Green
}

function Send-ToServiceNow {
    param([string]$FilePath,[string]$Serial,[string]$Hash)
    # Table API record + Attachment API file. Basic auth header built manually so
    # this works on Windows PowerShell 5.1 (the OOBE default).
    $Instance = $env:AP_SNOW_INSTANCE      # e.g. mountainside  (from *.service-now.com)
    $Table    = $env:AP_SNOW_TABLE         # e.g. u_autopilot_import  (a staging table)
    $User     = $env:AP_SNOW_USER
    $Pass     = $env:AP_SNOW_PASS          # <-- vault this
    foreach ($v in 'Instance','Table','User','Pass') {
        if (-not (Get-Variable $v -ValueOnly)) { throw "ServiceNow upload: missing $v (set AP_SNOW_* env vars)." }
    }

    $b64  = [Convert]::ToBase64String([Text.Encoding]::ASCII.GetBytes("$User`:$Pass"))
    $hdr  = @{ Authorization = "Basic $b64" }
    $base = "https://$Instance.service-now.com/api/now"

    $body = @{ serial_number = $Serial; u_hardware_hash = $Hash;
               u_source = "Get-AutopilotHash v3" } | ConvertTo-Json
    $rec  = Invoke-RestMethod -Method Post -Uri "$base/table/$Table" `
             -Headers $hdr -ContentType 'application/json' -Body $body
    $sysId = $rec.result.sys_id

    $name = Split-Path $FilePath -Leaf
    Invoke-RestMethod -Method Post `
        -Uri "$base/attachment/file?table_name=$Table&table_sys_id=$sysId&file_name=$name" `
        -Headers $hdr -ContentType 'text/csv' -InFile $FilePath | Out-Null
    Say "  Wrote ServiceNow record $sysId and attached $name" Green
}

if ($Upload) {
    if (-not $UploadTarget) { Say "-Upload set but no -UploadTarget; skipping." Yellow }
    else {
        Head "Upload"
        try {
            switch ($UploadTarget) {
                'SharePoint' { Send-ToSharePoint -FilePath $OutputPath }
                'ServiceNow' { Send-ToServiceNow -FilePath $OutputPath -Serial $deviceSerial -Hash $deviceHash }
            }
        } catch {
            Say "Upload failed: $($_.Exception.Message)" Red
            Say "CSV is still on disk at $OutputPath for manual handling." Yellow
        }
    }
}

Write-Host ""
Say "Next: Intune > Devices > Enrollment > Windows Autopilot > Devices > Import" Yellow
Say "Wait for Profile status = Assigned before booting the machine into setup." Yellow
if ($rebootNeeded) { Say "Reboot pending: the prefer-IPv4 change applies after restart." Yellow }
Write-Host ""
exit 0
