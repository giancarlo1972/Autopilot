# --- Win10 -> Win11 in-place upgrade (Installation Assistant, silent) ---
$dir = 'C:\Win11Upgrade'
New-Item -ItemType Directory -Path $dir -Force | Out-Null
$exe = Join-Path $dir 'Windows11InstallationAssistant.exe'

# Suspend BitLocker so the TPM/firmware change doesn't trigger a recovery-key prompt on reboot
Suspend-BitLocker -MountPoint 'C:' -RebootCount 2 -ErrorAction SilentlyContinue

# Official Microsoft download (verify current link on the software-download page)
Invoke-WebRequest -Uri 'https://go.microsoft.com/fwlink/?linkid=2171764' -OutFile $exe

# Silent upgrade, keep apps + files
Start-Process -FilePath $exe `
  -ArgumentList '/QuietInstall /SkipEULA /auto upgrade /NoRestartUI /copylogs ' + $dir `
  -Wait




# --- Variant: mounted ISO, no forced reboot ---
$iso = 'C:\Win11Upgrade\Win11_25H2.iso'   # download the ISO from the software-download page first
$vol = (Mount-DiskImage -ImagePath $iso -PassThru | Get-Volume).DriveLetter
Start-Process -FilePath "$vol`:\setup.exe" `
  -ArgumentList '/auto upgrade /quiet /eula accept /dynamicupdate enable /migratedrivers all /noreboot' `
  -Wait
Dismount-DiskImage -ImagePath $iso
# then reboot on your schedule:  Restart-Computer -Force






